+  // --- instrumentation (benchmarks/instrument.patch): read-only dumps ---
+  uint64_t DumpHash(bool use_counts) const {
+    const Word2Word2Double& t = use_counts ? counts : ttable;
+    uint64_t h = 1469598103934665603ULL;
+    auto mix = [&h](uint64_t v) { for (int b = 0; b < 8; ++b) { h ^= (v >> (8 * b)) & 0xff; h *= 1099511628211ULL; } };
+    for (unsigned i = 0; i < t.size(); ++i)
+      for (const auto& kv : t[i]) { uint64_t bits; std::memcpy(&bits, &kv.second, 8); mix(i); mix(kv.first); mix(bits); }
+    return h;
+  }
+  void DumpRow(std::ostream& o, unsigned e) const {
+    if (e >= counts.size()) return;
+    o << "row " << e << ' ' << counts[e].bucket_count() << ' ' << counts[e].size();
+    for (const auto& kv : counts[e]) o << ' ' << kv.first;
+    o << '\n';
+  }
+  size_t NumRows() const { return counts.size(); }
+  bool CopyOrderSame() const {
+    if (ttable.size() != counts.size()) return false;
+    for (unsigned i = 0; i < counts.size(); ++i) {
+      if (ttable[i].bucket_count() != counts[i].bucket_count()) return false;
+      auto a = ttable[i].begin(); auto b = counts[i].begin();
+      for (; a != ttable[i].end() && b != counts[i].end(); ++a, ++b) if (a->first != b->first) return false;
+      if (a != ttable[i].end() || b != counts[i].end()) return false;
+    }
+    return true;
+  }
